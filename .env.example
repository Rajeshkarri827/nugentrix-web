# ─────────────────────────────────────────────────────────────────
# Nugentrix — Microsoft 365 OAuth2 Configuration
# ─────────────────────────────────────────────────────────────────

# From Azure Portal → App registrations → your app → Overview
M365_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
M365_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# From Azure Portal → Certificates & secrets → Value
M365_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your LICENSED Microsoft 365 account (used to authenticate with Graph API)
# This account must have "Send As" permission on the shared mailbox
M365_USER=info@nugentrix.com

# The shared mailbox — shown to recipients as the sender
FROM_EMAIL=info@nugentrix.com

# The email that RECEIVES contact form submissions
TO_EMAIL=info@nugentrix.com

PORT=3001
